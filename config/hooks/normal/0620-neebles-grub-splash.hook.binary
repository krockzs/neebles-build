#!/bin/sh
set -e

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)"

MASCOT="$ROOT/config/includes.binary/boot/grub/neebles-mascot.png"
OUT="$ROOT/binary/boot/grub/splash.png"

VERSION="$(cat "$ROOT/chroot/etc/neebles/version" 2>/dev/null || echo 'N.E.E.B.L.E.S. OS')"
KERNEL="$(ls "$ROOT"/chroot/boot/vmlinuz-* 2>/dev/null | sort -V | tail -n1 | sed 's#^.*/vmlinuz-##')"
ARCH="$(chroot "$ROOT/chroot" dpkg --print-architecture 2>/dev/null || echo amd64)"

[ -n "$KERNEL" ] || KERNEL="unknown"

convert -size 1920x1080 xc:black \
  "$MASCOT" \
  -geometry +80+60 \
  -composite \
  -font DejaVu-Sans \
  -fill white \
  -pointsize 42 \
  -annotate +1380+900 "$VERSION" \
  -pointsize 30 \
  -fill '#B388FF' \
  -annotate +1380+945 "Kernel: $KERNEL" \
  -annotate +1380+985 "Architecture: $ARCH" \
  -alpha off \
  -type TrueColor \
  PNG24:"$OUT"
