#!/bin/bash

ASCII="/usr/share/neebles/neebles-ascii.txt"

VERSION="$(cat /etc/neebles/version 2>/dev/null)"
HOST="$(hostname)"
USER_NAME="$(id -un)"
KERNEL="$(uname -r)"
DESKTOP="${XDG_CURRENT_DESKTOP:-N/A}"
CPU="$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo)"
RAM="$(free -h | awk '/^Mem:/{print $3 " / " $2}')"
SHELL_NAME="$(basename "${SHELL:-/bin/bash}")"
UPTIME="$(uptime -p | sed 's/^up //')"

if command -v lspci >/dev/null 2>&1; then
    GPU="$(lspci | awk -F': ' '/VGA compatible controller|3D controller|Display controller/{print $2; exit}')"
else
    GPU="N/A"
fi

INFO="$(mktemp)"

{
    printf '\n'
    printf '\n'
    printf '\033[1;35m%s\033[0m\n' "${VERSION:-N.E.E.B.L.E.S. OS}"
    printf '\n'
    printf '\033[1;35mHost:\033[0m     %s\n' "$HOST"
    printf '\033[1;35mUser:\033[0m     %s\n' "$USER_NAME"
    printf '\033[1;35mKernel:\033[0m   %s\n' "$KERNEL"
    printf '\033[1;35mDesktop:\033[0m  %s\n' "$DESKTOP"
    printf '\033[1;35mCPU:\033[0m      %s\n' "$CPU"
    printf '\033[1;35mGPU:\033[0m      %s\n' "$GPU"
    printf '\033[1;35mRAM:\033[0m      %s\n' "$RAM"
    printf '\033[1;35mShell:\033[0m    %s\n' "$SHELL_NAME"
    printf '\033[1;35mUptime:\033[0m   %s\n' "$UPTIME"
} > "$INFO"

paste "$ASCII" "$INFO"

rm -f "$INFO"
