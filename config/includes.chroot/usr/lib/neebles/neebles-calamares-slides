#!/usr/bin/python3

import json
import os
import signal
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import urllib.error
import urllib.request
from pathlib import Path

BASE_URL = "https://raw.githubusercontent.com/krockzs/neebles-os/main/calamares/slides"

RUNTIME_BASE = Path("/run/neebles/calamares")
RUNTIME_DIR = RUNTIME_BASE / "slides"

PID_FILE = RUNTIME_BASE / "slides.pid"
ACTIVE_SLOT_FILE = RUNTIME_BASE / "active-slot"

MAX_SLIDES = 20

IMAGE_EXTENSIONS = ("png", "jpg", "jpeg")
VIDEO_EXTENSIONS = ("mp4",)
MEDIA_EXTENSIONS = IMAGE_EXTENSIONS + VIDEO_EXTENSIONS

MAX_IMAGE_SIZE = 4 * 1024 * 1024
MAX_VIDEO_SIZE = 100 * 1024 * 1024

RETRY_SECONDS = 3
ONLINE_CHECK_TIMEOUT = 2
DOWNLOAD_TIMEOUT = 120

HTTP_HOST = "127.0.0.1"
HTTP_PORT = 28765

CHUNK_SIZE = 1024 * 1024


running = True


def stop(signum, frame):
    global running
    running = False


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)


def max_size_for(extension):
    if extension in VIDEO_EXTENSIONS:
        return MAX_VIDEO_SIZE

    return MAX_IMAGE_SIZE


def fetch_slot(number, extension, timeout):
    url = f"{BASE_URL}/{number}.{extension}"
    max_size = max_size_for(extension)

    request = urllib.request.Request(
        url,
        headers={"User-Agent": "NEEBLES-Calamares/1.0.4"}
    )

    try:
        response = urllib.request.urlopen(request, timeout=timeout)

        if response.status != 200:
            response.close()
            return None

        length = response.headers.get("Content-Length")

        if length and int(length) > max_size:
            response.close()
            return None

        return response

    except (
        urllib.error.HTTPError,
        urllib.error.URLError,
        TimeoutError,
        OSError
    ):
        return None


def download_slot(number, extension):
    max_size = max_size_for(extension)
    destination = RUNTIME_DIR / f"{number}.{extension}"
    temporary = RUNTIME_DIR / f".{number}.{extension}.tmp"

    response = fetch_slot(number, extension, DOWNLOAD_TIMEOUT)

    if response is None:
        return False

    total = 0

    try:
        with response:
            with temporary.open("wb") as output:
                while running:
                    chunk = response.read(CHUNK_SIZE)

                    if not chunk:
                        break

                    total += len(chunk)

                    if total > max_size:
                        output.close()
                        temporary.unlink(missing_ok=True)
                        return False

                    output.write(chunk)

        if not running:
            temporary.unlink(missing_ok=True)
            return False

        if total == 0:
            temporary.unlink(missing_ok=True)
            return False

        for old_extension in MEDIA_EXTENSIONS:
            if old_extension == extension:
                continue

            old_file = RUNTIME_DIR / f"{number}.{old_extension}"
            old_file.unlink(missing_ok=True)

        os.replace(temporary, destination)

        return True

    except (OSError, ValueError):
        temporary.unlink(missing_ok=True)
        return False

def find_remote(number, timeout):
    for extension in MEDIA_EXTENSIONS:
        response = fetch_slot(number, extension, timeout)

        if response is not None:
            try:
                response.close()
            except Exception:
                pass

            return extension

    return None


def read_active_slot():
    try:
        value = ACTIVE_SLOT_FILE.read_text().strip()

        if value.isdigit():
            number = int(value)

            if 1 <= number <= MAX_SLIDES:
                return number

    except OSError:
        pass

    return None


def download_next(replaced_slots):
    global last_prepared_slot

    active_slot = read_active_slot()

    if last_prepared_slot is not None:
        start = (last_prepared_slot % MAX_SLIDES) + 1
    else:
        start = 1

    for offset in range(MAX_SLIDES):
        number = ((start - 1 + offset) % MAX_SLIDES) + 1

        if number == active_slot:
            continue

        extension = find_remote(number, ONLINE_CHECK_TIMEOUT)

        if extension is None:
            continue

        active_slot = read_active_slot()

        if number == active_slot:
            continue

        if download_slot(number, extension):
            replaced_slots.add(number)
            last_prepared_slot = number
            return number, extension

    return None


class RuntimeHandler(BaseHTTPRequestHandler):

    def log_message(self, format, *args):
        pass

    def send_json(self, status, payload):
        data = json.dumps(payload).encode("utf-8")

        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = self.path.split("?", 1)[0]

        if path == "/state":
            self.send_json(200, {
                "active_slot": read_active_slot(),
                "replaced_slots": sorted(replaced_slots),
                "max_slots": MAX_SLIDES
            })
            return

        if path.startswith("/active/"):
            value = path.rsplit("/", 1)[-1]

            if not value.isdigit():
                self.send_json(400, {"error": "invalid_slot"})
                return

            number = int(value)

            if not 1 <= number <= MAX_SLIDES:
                self.send_json(400, {"error": "invalid_slot"})
                return

            ACTIVE_SLOT_FILE.write_text(str(number))

            self.send_json(200, {
                "active_slot": number
            })
            return

        if path == "/prepare":
            with prepare_lock:
                active_slot = read_active_slot()

                prepared = download_next(replaced_slots)

                if prepared is None:
                    self.send_json(200, {
                        "prepared": False,
                        "active_slot": active_slot,
                        "replaced_slots": sorted(replaced_slots)
                    })
                    return

                slot, extension = prepared

                self.send_json(200, {
                    "prepared": True,
                    "slot": slot,
                    "extension": extension,
                    "active_slot": read_active_slot(),
                    "replaced_slots": sorted(replaced_slots)
                })
            return

        self.send_json(404, {"error": "not_found"})


prepare_lock = threading.Lock()


RUNTIME_BASE.mkdir(parents=True, exist_ok=True)
RUNTIME_DIR.mkdir(parents=True, exist_ok=True)

os.chmod(RUNTIME_BASE, 0o755)
os.chmod(RUNTIME_DIR, 0o755)

PID_FILE.write_text(str(os.getpid()))
ACTIVE_SLOT_FILE.unlink(missing_ok=True)

replaced_slots = set()
last_prepared_slot = None

server = ThreadingHTTPServer(
    (HTTP_HOST, HTTP_PORT),
    RuntimeHandler
)
server.timeout = 1

try:
    download_next(replaced_slots)
    next_retry = time.monotonic() + RETRY_SECONDS

    while running:
        server.handle_request()

        if not replaced_slots and time.monotonic() >= next_retry:
            download_next(replaced_slots)
            next_retry = time.monotonic() + RETRY_SECONDS

finally:
    server.server_close()
    PID_FILE.unlink(missing_ok=True)
    ACTIVE_SLOT_FILE.unlink(missing_ok=True)
