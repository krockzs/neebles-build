#!/usr/bin/env python3

from pathlib import Path
import subprocess
import sys

BACKEND = Path("/usr/bin/bwrap")

def fail(message):
    print("neebles-boundary-provider: " + message, file=sys.stderr)
    raise SystemExit(64)

def clean_absolute(value, label):
    path = Path(value)

    if not path.is_absolute():
        fail(label + " must be absolute: " + value)

    if ".." in path.parts:
        fail(label + " cannot contain parent traversal: " + value)

    return path

def main():
    arguments = sys.argv[1:]
    root = None
    readonly = []
    writable = []
    environment = {}
    mount_proc = False
    mount_dev = False
    mount_tmp = False
    chdir = None
    command = None
    index = 0

    while index < len(arguments):
        value = arguments[index]

        if value == "--":
            command = arguments[index + 1:]
            break

        if value == "--root":
            if index + 1 >= len(arguments):
                fail("missing value for --root")
            root = clean_absolute(arguments[index + 1], "root")
            index += 2
            continue

        if value == "--environment":
            if index + 2 >= len(arguments):
                fail("missing values for --environment")

            key = arguments[index + 1]
            environment_value = arguments[index + 2]

            if not key:
                fail("environment key cannot be empty")

            if not (
                key.isascii()
                and (key[0] == "_" or key[0].isalpha())
                and all(
                    character == "_" or character.isalnum()
                    for character in key[1:]
                )
            ):
                fail("invalid environment key: " + key)

            if key in environment:
                fail("duplicate environment key: " + key)

            environment[key] = environment_value
            index += 3
            continue

        if value in ("--readonly-data", "--writable-data"):
            if index + 2 >= len(arguments):
                fail("missing values for " + value)

            source = clean_absolute(arguments[index + 1], value + " source")
            destination = clean_absolute(arguments[index + 2], value + " destination")

            if value == "--readonly-data":
                readonly.append((source, destination))
            else:
                writable.append((source, destination))

            index += 3
            continue

        if value == "--proc":
            mount_proc = True
            index += 1
            continue

        if value == "--dev":
            mount_dev = True
            index += 1
            continue

        if value == "--tmp":
            mount_tmp = True
            index += 1
            continue

        if value == "--chdir":
            if index + 1 >= len(arguments):
                fail("missing value for --chdir")
            chdir = clean_absolute(arguments[index + 1], "chdir")
            index += 2
            continue

        fail("unknown protocol argument: " + value)

    if root is None:
        fail("missing --root")

    if not root.is_dir():
        fail("root is not a directory: " + str(root))

    if not command:
        fail("missing command after --")

    if not BACKEND.is_file():
        fail("boundary backend missing: " + str(BACKEND))

    destinations = set()

    for mode, grants in [("readonly-data", readonly), ("writable-data", writable)]:
        for source, destination in grants:
            if not source.exists():
                fail(mode + " source missing: " + str(source))

            key = str(destination)

            if key in destinations:
                fail("duplicate external data destination: " + key)

            destinations.add(key)

    overlay_tops = set()
    missing_top_levels = set()

    for source, destination in readonly + writable:
        inside = root / destination.relative_to('/')

        if inside.exists():
            continue

        parts = destination.parts

        if len(parts) < 2:
            fail('external data destination cannot be root')

        top_name = parts[1]
        source_top = root / top_name

        if source_top.exists():
            if not source_top.is_dir():
                fail(
                    'external data destination top-level is not a directory: '
                    + str(source_top)
                )

            overlay_tops.add(top_name)
        else:
            missing_top_levels.add(top_name)

    if missing_top_levels:
        backend_args = [
            str(BACKEND),
            '--tmpfs',
            '/',
        ]

        for root_entry in sorted(
            root.iterdir(),
            key=lambda path: path.name,
        ):
            backend_args.extend(
                [
                    '--ro-bind',
                    str(root_entry),
                    '/'
                    + root_entry.name,
                ]
            )

        for top_name in sorted(missing_top_levels):
            backend_args.extend(
                [
                    '--dir',
                    '/'
                    + top_name,
                ]
            )
    else:
        backend_args = [
            str(BACKEND),
            '--ro-bind',
            str(root),
            '/',
        ]

    for top_name in sorted(overlay_tops):
        backend_args.extend(
            [
                '--overlay-src',
                str(root / top_name),
                '--tmp-overlay',
                '/'
                + top_name,
            ]
        )

    if mount_proc:
        backend_args.extend(['--proc', '/proc'])

    if mount_dev:
        backend_args.extend(['--dev', '/dev'])

    if mount_tmp:
        backend_args.extend(['--tmpfs', '/tmp'])

    destination_directories = set()

    for source, destination in readonly + writable:
        parent = destination.parent

        while parent != Path("/") and parent != Path("."):
            physical_parent = root / parent.relative_to("/")

            if not physical_parent.exists() or (
                mount_tmp
                and len(parent.parts) >= 2
                and parent.parts[1] == "tmp"
            ):
                destination_directories.add(parent)

            parent = parent.parent

    for directory in sorted(
        destination_directories,
        key=lambda path: (len(path.parts), str(path)),
    ):
        backend_args.extend(
            [
                "--dir",
                str(directory),
            ]
        )

    for source, destination in readonly:
        backend_args.extend(['--ro-bind', str(source), str(destination)])

    for source, destination in writable:
        backend_args.extend(['--bind', str(source), str(destination)])

    backend_args.append('--clearenv')


    for key in sorted(environment):
        backend_args.extend(
            [
                "--setenv",
                key,
                environment[key],
            ]
        )
    if chdir is not None:
        backend_args.extend(['--chdir', str(chdir)])

    backend_args.extend(command)

    result = subprocess.run(backend_args)

    raise SystemExit(result.returncode)

if __name__ == "__main__":
    main()
