#!/usr/bin/env python3

import json
import os
import stat
import sys
from pathlib import Path

AUTHORITY = "platform.desktop_session_interface"
PROTOCOL = "neebles-desktop-session-interface-v1"
OUTPUT_NAME = "neebles-capability-provider-output"
OUTPUT_SCHEMA = "1"

UID_KEY = "NEEBLES_DESKTOP_UID"
GID_KEY = "NEEBLES_DESKTOP_GID"

DISPLAY_KEY = "DISPLAY"
WAYLAND_DISPLAY_KEY = "WAYLAND_DISPLAY"
XAUTHORITY_KEY = "XAUTHORITY"


def fail(message):
    print("neebles-desktop-session-provider: " + message, file=sys.stderr)
    raise SystemExit(64)


def parse_identity():
    uid_raw = os.environ.get(UID_KEY)
    gid_raw = os.environ.get(GID_KEY)

    if uid_raw is None or gid_raw is None:
        fail("desktop UID and GID must be supplied together")

    try:
        uid = int(uid_raw, 10)
    except ValueError:
        fail("desktop UID must be an unsigned integer")

    try:
        gid = int(gid_raw, 10)
    except ValueError:
        fail("desktop GID must be an unsigned integer")

    if uid < 0:
        fail("desktop UID cannot be negative")

    if gid < 0:
        fail("desktop GID cannot be negative")

    return uid, gid


def inspect_runtime_directory(uid):
    runtime_dir = Path("/run/user") / str(uid)

    try:
        info = runtime_dir.stat()
    except FileNotFoundError:
        fail("desktop runtime directory does not exist")
    except OSError as error:
        fail("could not inspect desktop runtime directory: " + str(error))

    if not stat.S_ISDIR(info.st_mode):
        fail("desktop runtime path is not a directory")

    if info.st_uid != uid:
        fail(
            "desktop runtime directory owner mismatch: "
            + str(info.st_uid)
            + " != "
            + str(uid)
        )

    return runtime_dir


def inspect_session_bus(runtime_dir, uid):
    bus = runtime_dir / "bus"

    try:
        info = bus.stat()
    except FileNotFoundError:
        fail("desktop session bus does not exist")
    except OSError as error:
        fail("could not inspect desktop session bus: " + str(error))

    if not stat.S_ISSOCK(info.st_mode):
        fail("desktop session bus path is not a Unix socket")

    if info.st_uid != uid:
        fail(
            "desktop session bus owner mismatch: "
            + str(info.st_uid)
            + " != "
            + str(uid)
        )

    return bus


def optional_graphical_values(runtime_dir, uid):
    values = {}

    display = os.environ.get(DISPLAY_KEY)

    if display:
        display = display.strip()

        if not display.startswith(":"):
            fail("DISPLAY must use local :N syntax")

        number = display[1:].split(".", 1)[0]

        if not number.isdigit():
            fail("DISPLAY must contain a numeric local display")

        socket_path = Path("/tmp/.X11-unix") / ("X" + number)

        try:
            info = socket_path.stat()
        except OSError as error:
            fail("DISPLAY socket is unavailable: " + str(error))

        if not stat.S_ISSOCK(info.st_mode):
            fail("DISPLAY target is not a Unix socket")

        values[DISPLAY_KEY] = display

    wayland = os.environ.get(WAYLAND_DISPLAY_KEY)

    if wayland:
        wayland = wayland.strip()

        if not wayland or "/" in wayland or wayland in {".", ".."}:
            fail("WAYLAND_DISPLAY must be a session-local basename")

        socket_path = runtime_dir / wayland

        try:
            info = socket_path.stat()
        except OSError as error:
            fail("WAYLAND_DISPLAY socket is unavailable: " + str(error))

        if not stat.S_ISSOCK(info.st_mode):
            fail("WAYLAND_DISPLAY target is not a Unix socket")

        if info.st_uid != uid:
            fail("WAYLAND_DISPLAY socket owner mismatch")

        values[WAYLAND_DISPLAY_KEY] = wayland

    xauthority = os.environ.get(XAUTHORITY_KEY)

    if xauthority:
        xauthority = Path(xauthority.strip())

        if not xauthority.is_absolute():
            fail("XAUTHORITY must be absolute")

        try:
            xauthority.relative_to(runtime_dir)
        except ValueError:
            fail("XAUTHORITY must live inside desktop runtime directory")

        try:
            info = xauthority.stat()
        except OSError as error:
            fail("XAUTHORITY is unavailable: " + str(error))

        if not stat.S_ISREG(info.st_mode):
            fail("XAUTHORITY must be a regular file")

        if info.st_uid != uid:
            fail("XAUTHORITY owner mismatch")

        values[XAUTHORITY_KEY] = str(xauthority)

    return values


def main():
    uid, gid = parse_identity()

    runtime_dir = inspect_runtime_directory(uid)
    bus = inspect_session_bus(runtime_dir, uid)

    values = {
        "XDG_RUNTIME_DIR": str(runtime_dir),
        "DBUS_SESSION_BUS_ADDRESS": "unix:path=" + str(bus)
    }

    values.update(
        optional_graphical_values(
            runtime_dir,
            uid,
        )
    )

    output = {
        "schema": OUTPUT_SCHEMA,
        "name": OUTPUT_NAME,
        "authority": AUTHORITY,
        "protocol": PROTOCOL,
        "values": values
    }

    json.dump(
        output,
        sys.stdout,
        separators=(",", ":"),
        sort_keys=True
    )

    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
