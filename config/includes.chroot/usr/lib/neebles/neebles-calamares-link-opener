#!/usr/bin/python3
"""Unprivileged, allowlisted Calamares slideshow URL opener.

Runs as the desktop user, never as root. The only openable URLs are HTTPS
link targets already present in the current, validated slide text.
"""

import json
import os
import re
import subprocess
import time
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from urllib.parse import urlsplit

HOST = "127.0.0.1"
PORT = 28766
SLIDES = Path("/run/neebles/calamares/slides")
ACTIVE_SLOT = Path("/run/neebles/calamares/active-slot")
LINK_RE = re.compile(r"^\[link=(https://[^\]\r\n]+)\]$", re.MULTILINE | re.IGNORECASE)
MAX_TEXT_BYTES = 64 * 1024
MAX_REQUEST_BYTES = 4096


def valid_url(url):
    if not isinstance(url, str) or len(url) > 2048:
        return False
    if not re.fullmatch(r'''https://[^\s<>"']+''', url, flags=re.I):
        return False
    try:
        parts = urlsplit(url)
        return (
            parts.scheme.lower() == "https"
            and bool(parts.hostname)
            and parts.username is None
            and parts.password is None
            and (parts.port is None or 1 <= parts.port <= 65535)
        )
    except (ValueError, AttributeError):
        return False


def allowed_link(slot, url):
    if not isinstance(slot, int) or not 1 <= slot <= 20 or not valid_url(url):
        return False
    try:
        active = ACTIVE_SLOT.read_text(encoding="ascii").strip()
        if active != str(slot):
            return False
        path = SLIDES / f"{slot}.txt"
        if not path.is_file() or path.stat().st_size > MAX_TEXT_BYTES:
            return False
        content = path.read_text(encoding="utf-8")
        return url in {m.group(1) for m in LINK_RE.finditer(content)}
    except (OSError, UnicodeError):
        return False


def desktop_openers(url):
    """KDE-native first, then XDG/GIO default handlers, finally ISO browser.

    No shell interpretation, no user-supplied executable, and no privileged
    process. The Firefox fallback is only used if all default handlers fail.
    """
    candidates = (
        ("/usr/bin/kde-open", url),
        ("/usr/bin/xdg-open", url),
        ("/usr/bin/gio", "open", url),
        ("/usr/bin/firefox-esr", "--new-tab", url),
    )
    return [list(argv) for argv in candidates if Path(argv[0]).is_file()]


def open_url(url):
    """Launch a URL from the desktop user session, with ordered fallbacks."""
    if os.geteuid() == 0 or not valid_url(url):
        return False
    if not any(os.environ.get(k) for k in (
        "DISPLAY", "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS"
    )):
        return False

    for argv in desktop_openers(url):
        command_name = Path(argv[0]).name
        try:
            proc = subprocess.Popen(
                argv,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                close_fds=True,
            )
            try:
                code = proc.wait(timeout=1.25)
                if code == 0:
                    print(f"NEEBLES LINK: {command_name} accepted desktop URL", flush=True)
                    return True
                print(f"NEEBLES LINK: {command_name} failed (exit={code})", flush=True)
            except subprocess.TimeoutExpired:
                # A browser can remain running after processing the request.
                print(f"NEEBLES LINK: {command_name} still running", flush=True)
                return True
        except OSError as error:
            print(f"NEEBLES LINK: {command_name} unavailable ({type(error).__name__})", flush=True)

    print("NEEBLES LINK: all desktop URL handlers failed", flush=True)
    return False


class LinkHandler(BaseHTTPRequestHandler):
    server_version = "NEEBLES-Calamares-URL/1.0"

    def end_cors_headers(self):
        # A local QML document may send Origin: null when POSTing JSON.
        # Avoid wildcard CORS for this user-side localhost service.
        if self.headers.get("Origin", "") == "null":
            self.send_header("Access-Control-Allow-Origin", "null")
            self.send_header("Vary", "Origin")

    def do_OPTIONS(self):
        if self.path != "/open-link" or self.headers.get("Origin", "") != "null":
            self.respond(403, False, "origin_not_allowed")
            return
        self.send_response(204)
        self.end_cors_headers()
        self.send_header("Access-Control-Allow-Methods", "POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Access-Control-Max-Age", "60")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def respond(self, code, ok, error=None):
        obj = {"ok": ok}
        if error:
            obj["error"] = error
        data = json.dumps(obj, separators=(",", ":")).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.end_cors_headers()
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/health":
            self.respond(200, True)
        else:
            self.respond(404, False, "not_found")

    def do_POST(self):
        if self.path != "/open-link":
            self.respond(404, False, "not_found")
            return
        if self.headers.get("Content-Type", "").split(";", 1)[0].strip().lower() != "application/json":
            self.respond(415, False, "content_type")
            return
        try:
            size = int(self.headers.get("Content-Length", "0"))
            if not 1 <= size <= MAX_REQUEST_BYTES:
                raise ValueError("bad_size")
            payload = json.loads(self.rfile.read(size).decode("utf-8"))
            if not isinstance(payload, dict) or type(payload.get("slot")) is not int:
                raise ValueError("bad_payload")
        except (ValueError, UnicodeError, json.JSONDecodeError):
            self.respond(400, False, "bad_payload")
            return
        url = payload.get("url")
        if not allowed_link(payload["slot"], url):
            self.respond(403, False, "not_declared_or_inactive")
            return
        if not open_url(url):
            self.respond(503, False, "desktop_open_failed")
            return
        self.respond(200, True)

    def log_message(self, fmt, *args):
        # Never print potentially sensitive URLs or query data.
        return


def main():
    if os.geteuid() == 0:
        print("FATAL: URL helper must run as the desktop user, never root", file=sys.stderr)
        return 1
    if not Path("/usr/bin/xdg-open").is_file():
        print("FATAL: /usr/bin/xdg-open missing", file=sys.stderr)
        return 1
    try:
        http = HTTPServer((HOST, PORT), LinkHandler)
        print("NEEBLES LINK: helper ready on 127.0.0.1:28766", flush=True)
        http.serve_forever(poll_interval=0.4)
    except OSError as e:
        print(f"FATAL: URL helper unavailable: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
