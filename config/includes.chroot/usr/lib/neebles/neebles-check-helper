#!/usr/bin/python3

import importlib.machinery
import json
import sys
import types
from pathlib import Path


CHECKER = Path("/usr/bin/neebles-check")

COMPONENTS = {
    "boss": Path(
        "/opt/neebles-build/boss"
    ),
    "calamares": Path(
        "/opt/neebles-build/calamares"
    ),
}

ROOTS = {
    "packages",
    "rootfs",
}


def load_checker():
    loader = importlib.machinery.SourceFileLoader(
        "neebles_check_runtime",
        str(CHECKER),
    )

    module = types.ModuleType(
        loader.name
    )

    loader.exec_module(
        module
    )

    return module


def inventory(module, component):
    root = COMPONENTS[component]

    if not root.is_dir():
        return {
            "present": False,
            "inventory": {},
        }

    return {
        "present": True,
        "inventory": module.local_inventory(
            root,
            ROOTS,
        ),
    }


def main():
    raw = sys.stdin.readline(
        128
    ).strip()

    if raw not in {
        "boss",
        "calamares",
        "all",
    }:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": "invalid_operation",
                }
            )
        )

        return 2

    module = load_checker()

    if raw == "all":
        data = {
            name: inventory(
                module,
                name,
            )
            for name in (
                "boss",
                "calamares",
            )
        }

        print(
            json.dumps(
                {
                    "ok": True,
                    "operation": raw,
                    "components": data,
                },
                separators=(",", ":"),
            )
        )

        return 0

    data = inventory(
        module,
        raw,
    )

    print(
        json.dumps(
            {
                "ok": True,
                "operation": raw,
                "present": data["present"],
                "inventory": data["inventory"],
            },
            separators=(",", ":"),
        )
    )

    return 0


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
