[Unit]
Description=NEEBLES Check privileged inventory helper

[Service]
Type=oneshot
TimeoutStartSec=30min
ExecStart=/usr/lib/neebles/neebles-check-helper
User=root
Group=root
StandardInput=socket
StandardOutput=socket
StandardError=journal
NoNewPrivileges=yes
PrivateNetwork=no
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/neebles-build
ReadWritePaths=-/opt/neebles/client
ReadWritePaths=-/usr/local/bin
ReadWritePaths=-/usr/share/icons/hicolor/256x256/apps
ReadWritePaths=-/usr/share/applications
ReadWritePaths=-/usr/lib/systemd/user
ReadWritePaths=-/usr/lib/systemd/system
ReadWritePaths=-/etc/systemd/system
ReadWritePaths=-/etc/systemd/user
ReadWritePaths=-/etc/xdg/autostart
ReadWritePaths=-/etc/neebles
ReadWritePaths=-/usr/share/plasma/plasmoids
ReadWritePaths=-/usr/lib/x86_64-linux-gnu/qt6/qml/NEEBLES
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
