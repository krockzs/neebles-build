#!/usr/lib/neebles/neebles-check/restore/rootfs/usr/bin/busybox sh
ROOT=/usr/lib/neebles/neebles-check/restore/rootfs
LOADER=$ROOT/usr/lib64/ld-linux-x86-64.so.2
LIBS=$ROOT/usr/lib/x86_64-linux-gnu
PYTHON=$ROOT/usr/bin/python3
export PYTHONHOME=$ROOT/usr
export LD_LIBRARY_PATH=$LIBS
export SSL_CERT_FILE=$ROOT/etc/ssl/certs/ca-certificates.crt
exec $LOADER --library-path $LIBS $PYTHON /usr/lib/neebles/neebles-check/runtime/neebles-check.py "$@"
