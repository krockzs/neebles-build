#!/bin/sh

###
# N.E.E.B.L.E.S. wrapper for Calamares
###

sudo mv /etc/fstab /etc/fstab.orig.calamares 2>/dev/null || true

export QT_AUTO_SCREEN_SCALE_FACTOR=1

SLIDES_PID_FILE="/run/neebles/calamares/slides.pid"

if [ -x /usr/lib/neebles/neebles-calamares-slides ]; then
    sudo rm -f "$SLIDES_PID_FILE"
    sudo /opt/neebles-build/calamares/rootfs/lib64/ld-linux-x86-64.so.2 --library-path /opt/neebles-build/calamares/rootfs/lib/x86_64-linux-gnu:/opt/neebles-build/calamares/rootfs/usr/lib/x86_64-linux-gnu:/opt/neebles-build/calamares/rootfs/usr/lib/x86_64-linux-gnu/libproxy /opt/neebles-build/calamares/rootfs/usr/bin/python3 /opt/neebles-build/calamares/rootfs/usr/lib/neebles/neebles-calamares-slides >/dev/null 2>&1 &
fi

xhost +si:localuser:root >/dev/null 2>&1 || true

LINK_OPENER_PID=""
# Calamares runs under pkexec, but this bridge MUST remain in the desktop
# user's KDE session. Preserve diagnostics instead of discarding errors.
if [ "$(id -u)" -ne 0 ] && [ -x /usr/lib/neebles/neebles-calamares-link-opener ]; then
    LINK_OPENER_LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/neebles"
    if mkdir -p -m 700 "$LINK_OPENER_LOG_DIR" 2>/dev/null; then
        LINK_OPENER_LOG="$LINK_OPENER_LOG_DIR/calamares-link-opener.log"
    else
        LINK_OPENER_LOG="/dev/null"
    fi
    /usr/lib/neebles/neebles-calamares-link-opener >>"$LINK_OPENER_LOG" 2>&1 &
    LINK_OPENER_PID=$!

    # The GUI must not race the helper's HTTP bind. No new package needed:
    # curl is already part of the NEEBLES bootstrap infrastructure.
    if command -v curl >/dev/null 2>&1; then
        LINK_ATTEMPTS=0
        while [ "$LINK_ATTEMPTS" -lt 25 ]; do
            if curl --noproxy '*' --silent --fail --max-time 1 \
                http://127.0.0.1:28766/health >/dev/null 2>&1; then
                break
            fi
            if ! kill -0 "$LINK_OPENER_PID" 2>/dev/null; then
                break
            fi
            LINK_ATTEMPTS=$((LINK_ATTEMPTS + 1))
            sleep 0.1
        done
    fi
fi

pkexec /opt/neebles-build/calamares/neebles-calamares-launcher
if [ -n "$LINK_OPENER_PID" ]; then
    kill "$LINK_OPENER_PID" 2>/dev/null || true
    wait "$LINK_OPENER_PID" 2>/dev/null || true
fi


xhost -si:localuser:root >/dev/null 2>&1 || true

if [ -f "$SLIDES_PID_FILE" ]; then
    SLIDES_PID="$(cat "$SLIDES_PID_FILE" 2>/dev/null || true)"

    case "$SLIDES_PID" in
        ''|*[!0-9]*) ;;
        *)
            sudo kill "$SLIDES_PID" 2>/dev/null || true
            ;;
    esac
fi

sudo rm -rf /run/neebles/calamares/slides
sudo rm -f "$SLIDES_PID_FILE"

if [ -f /etc/fstab.orig.calamares ]; then
    sudo mv /etc/fstab.orig.calamares /etc/fstab
fi
